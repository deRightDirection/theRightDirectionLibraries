<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AssemblyVersion>10.0.2.0</AssemblyVersion>
	  <FileVersion>10.0.2.0</FileVersion>
	  <Version>10.0.2.0</Version>
	  <ApplicationIcon>theRightDirection.ico</ApplicationIcon>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Copyright>the Right Direction BV</Copyright>
	  <PackageProjectUrl>https://www.therightdirection.nl</PackageProjectUrl>
	  <PackageIcon>tRD-icon-v-400.jpg</PackageIcon>
	  <ApplicationIcon>tRD-icon-v-400.ico</ApplicationIcon>
	  <Company>the Right Direction BV</Company>
	  <RepositoryUrl>https://www.therightdirection.nl</RepositoryUrl>
	  <DebugType>none</DebugType>
	  <AllowUnsafeBlocks>false</AllowUnsafeBlocks>  
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutputPath>C:\GitHub\SharedLibraries\</OutputPath>
	</PropertyGroup>

  <ItemGroup>
    <None Remove="tRD-icon-v-400.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tRD-icon-v-400.ico" />
    <Content Include="tRD-icon-v-400.jpg">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
    </Content>
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="MaxMind.Db" Version="5.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.10" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="theRightDirection.Library" Version="10.0.2" />
	</ItemGroup>
</Project>
