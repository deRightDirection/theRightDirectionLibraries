<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AssemblyVersion>10.0.2.0</AssemblyVersion>
	  <FileVersion>10.0.2.0</FileVersion>
	  <Version>10.0.2.0</Version>
	  <ApplicationIcon>theRightDirection.ico</ApplicationIcon>
	  <Company>the Right Direction BV</Company>
	  <Copyright>the Right Direction BV</Copyright>
	  <PackageProjectUrl>https://www.therightdirection.nl</PackageProjectUrl>
	  <PackageIcon>tRD-icon-v-400.jpg</PackageIcon>
	  <RepositoryUrl>https://www.therightdirection.nl</RepositoryUrl>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutputPath>C:\GitHub\SharedLibraries\</OutputPath>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="tRD-icon-v-400.jpg" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="theRightDirection.ico" />
		<Content Include="tRD-icon-v-400.jpg">
		  <PackagePath>\</PackagePath>
		  <Pack>True</Pack>
		</Content>
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Refit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\theRightDirection.Library.NetCore\theRightDirection.Library.csproj" />
  </ItemGroup>

</Project>
